---
import Base from '../layouts/Base.astro';
---

<Base title="About Me">
  <h1>About Me</h1>
  
  <p>
    Over the past two years, I've supported B2B growth cycles and recruitment strategies that improved lead conversion and talent alignment. My analytical mindset helps me bridge the gap between data, people, and business value.
  </p>
  
  <p>
    I'm currently pursuing my Master's in Operations Research and Business Analytics at 
    <strong>Otto von Guericke University, Magdeburg, Germany</strong> and I'm excited about 
    opportunities where I can apply optimization and analytics to real-world challenges — 
    especially in environments that value collaboration, innovation, and continuous learning.
  </p>

  <div class="about-links">
    <a href="https://www.linkedin.com/in/nasiyapervez/" target="_blank" class="about-link">
      LinkedIn
    </a>
    <a href="https://github.com/NasiyaPervez" target="_blank" class="about-link">
      GitHub
    </a>
    <a href="https://vsco.co/nasiya-pervez/gallery" target="_blank" class="about-link">
      VSCO
    </a>
  </div>

  <style>
    p {
      margin-bottom: 20px;
    }
    
    strong {
      color: #fff;
    }
    
    .about-links {
      display: flex;
      gap: 20px;
      margin-top: 40px;
      animation: fadeInUp 0.6s ease-out backwards;
      animation-delay: 0.4s;
    }
    
    .about-link {
      padding: 12px 24px;
      background: #1a1a1a;
      border: 1px solid #2a2a2a;
      border-radius: 8px;
      text-decoration: none;
      color: #888;
      font-weight: 500;
      transition: all 0.3s ease;
    }
    
    .about-link:hover {
      background: #fff;
      color: #0a0a0a;
      transform: translateY(-3px);
      box-shadow: 0 8px 25px rgba(255, 255, 255, 0.1);
    }
  </style>
</Base>