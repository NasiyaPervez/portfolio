---
import Base from '../layouts/Base.astro';
---

<Base title="About Me">
  <h1>About Me</h1>
  
  <p>
    Hi! I'm Nasiya. I work in supply chain and have a passion for data analysis, 
    machine learning, and creative storytelling through photography.
  </p>
  
  <p>
    I'm currently learning SAP ERP and expanding my skills in supply chain management. 
    When I'm not working, you'll find me exploring photography on VSCO or writing 
    about data science on my blog.
  </p>

  <div class="about-links">
    <a href="https://www.linkedin.com/in/nasiyapervez/" target="_blank" class="about-link">
      LinkedIn
    </a>
    <a href="https://github.com/NasiyaPervez" target="_blank" class="about-link">
      GitHub
    </a>
    <a href="https://vsco.co/nasiya-pervez/gallery" target="_blank" class="about-link">
      VSCO
    </a>
  </div>

  <style>
    p {
      margin-bottom: 20px;
    }
    
    .about-links {
      display: flex;
      gap: 20px;
      margin-top: 40px;
      animation: fadeInUp 0.6s ease-out backwards;
      animation-delay: 0.4s;
    }
    
    .about-link {
      padding: 12px 24px;
      background: #1a1a1a;
      border: 1px solid #2a2a2a;
      border-radius: 8px;
      text-decoration: none;
      color: #888;
      font-weight: 500;
      transition: all 0.3s ease;
    }
    
    .about-link:hover {
      background: #fff;
      color: #0a0a0a;
      transform: translateY(-3px);
      box-shadow: 0 8px 25px rgba(255, 255, 255, 0.1);
    }
  </style>
</Base>