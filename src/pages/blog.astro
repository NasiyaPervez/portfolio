---
import Base from '../layouts/Base.astro';
import { getSubstackPosts } from '../lib/substack';

const posts = getSubstackPosts();
---

<Base
  title="Blog"
  description="Blog — data analytics, machine learning, and supply chain topics. Auto-published from Substack by Nasiya Pervez."
>
  <section class="page-head reveal">
    <p class="eyebrow">Writing</p>
    <h1>Blog</h1>
    <p class="lede">Articles on data analytics and machine learning — with supply chain topics on the way. Written on Substack, published here.</p>
  </section>

  <section class="section blog-grid">
    {
      posts.map((post, index) => (
        <a class="blog-card reveal" style={`--d: ${Math.min(index * 0.05, 0.4)}s`} href={post.link} target="_blank" rel="noopener">
          <time>{new Date(post.pubDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</time>
          <h2>{post.title}</h2>
          <p>{post.description}</p>
          <span class="read-more">Read on Substack →</span>
        </a>
      ))
    }
  </section>

  <style>
    .page-head {
      padding: 24px 0 8px;
    }

    .lede {
      max-width: 640px;
      font-size: 1.05rem;
      margin-top: 10px;
    }

    .blog-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 18px;
      margin-top: 24px;
    }

    .blog-card {
      display: flex;
      flex-direction: column;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 26px;
      transition: transform 0.25s ease, border-color 0.25s ease;
    }

    .blog-card:hover {
      transform: translateY(-4px);
      border-color: var(--emerald);
    }

    .blog-card time {
      font-size: 0.8rem;
      color: var(--faint);
      margin-bottom: 10px;
    }

    .blog-card h2 {
      font-size: 1.12rem;
      line-height: 1.4;
      margin-bottom: 10px;
    }

    .blog-card p {
      font-size: 0.95rem;
      margin-bottom: 16px;
      flex: 1;
    }

    .read-more {
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--emerald);
    }

    @media (max-width: 480px) {
      .blog-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</Base>