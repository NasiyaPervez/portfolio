---
import Base from '../layouts/Base.astro';
---

<Base title="Contact">
  <h1>Contact Me</h1>
  
  <p>Feel free to reach out!</p>
  
  <div class="contact-links">
    <a href="mailto:perveznasiya@gmail.com" class="contact-item">
      ✉️ Email
    </a>
    <a href="https://www.linkedin.com/in/nasiyapervez/" target="_blank" class="contact-item">
      💼 LinkedIn
    </a>
    <a href="https://github.com/NasiyaPervez" target="_blank" class="contact-item">
      🐙 GitHub
    </a>
  </div>

  <style>
    .contact-links {
      display: flex;
      gap: 16px;
      margin-top: 32px;
      flex-wrap: wrap;
      animation: fadeInUp 0.6s ease-out backwards;
      animation-delay: 0.4s;
    }
    
    .contact-item {
      display: inline-block;
      padding: 14px 28px;
      background: #1a1a1a;
      border: 1px solid #2a2a2a;
      border-radius: 8px;
      text-decoration: none;
      color: #888;
      font-weight: 500;
      transition: all 0.3s ease;
    }
    
    .contact-item:hover {
      background: #fff;
      color: #0a0a0a;
      transform: translateY(-3px);
      box-shadow: 0 8px 25px rgba(255, 255, 255, 0.1);
    }
    
    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  </style>
</Base>