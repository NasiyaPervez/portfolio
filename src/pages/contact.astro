---
import Base from '../layouts/Base.astro';
---

<Base
  title="Contact"
  description="Contact Nasiya Pervez — supply chain, logistics, and data analytics opportunities."
>
  <section class="page-head reveal">
    <p class="eyebrow">Contact</p>
    <h1>Let's talk supply chain</h1>
    <p class="lede">Open to logistics, planning, and forecasting roles — or a conversation over a complex dataset.</p>
  </section>

  <section class="section contact-grid">
    <a href="mailto:perveznasiya@gmail.com" class="contact-card reveal" style="--d: 0.05s">
      <span class="contact-icon">✉️</span>
      <span class="contact-label">Email</span>
      <span class="contact-value">perveznasiya@gmail.com</span>
    </a>

    <a href="https://www.linkedin.com/in/nasiyapervez/" target="_blank" rel="noopener" class="contact-card reveal" style="--d: 0.1s">
      <span class="contact-icon">💼</span>
      <span class="contact-label">LinkedIn</span>
      <span class="contact-value">in/nasiyapervez</span>
    </a>

    <a href="https://github.com/NasiyaPervez" target="_blank" rel="noopener" class="contact-card reveal" style="--d: 0.15s">
      <span class="contact-icon">🧮</span>
      <span class="contact-label">GitHub</span>
      <span class="contact-value">NasiyaPervez</span>
    </a>
  </section>

  <section class="section note reveal" style="--d: 0.2s">
    <p>
      Prefer email? My inbox is open — I usually reply within a day or two.
      A contact form is on the roadmap.
    </p>
  </section>

  <style>
    .page-head {
      padding: 24px 0 8px;
    }

    .lede {
      max-width: 560px;
      font-size: 1.05rem;
      margin-top: 10px;
    }

    .contact-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 18px;
      margin-top: 24px;
    }

    .contact-card {
      display: flex;
      flex-direction: column;
      gap: 4px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 28px;
      transition: transform 0.25s ease, border-color 0.25s ease;
    }

    .contact-card:hover {
      transform: translateY(-4px);
      border-color: var(--emerald);
    }

    .contact-icon {
      font-size: 1.5rem;
      margin-bottom: 10px;
    }

    .contact-label {
      font-weight: 600;
      color: var(--white);
    }

    .contact-value {
      font-size: 0.9rem;
      color: var(--faint);
      word-break: break-all;
    }

    .note {
      margin-top: 8px;
    }

    .note p {
      max-width: 560px;
      color: var(--faint);
    }
  </style>
</Base>