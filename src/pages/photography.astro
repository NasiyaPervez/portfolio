---
import Base from '../layouts/Base.astro';
---

<Base
  title="Photography"
  description="Photography — a gallery of work on VSCO by Nasiya Pervez."
>
  <section class="page-head reveal">
    <p class="eyebrow">Personal</p>
    <h1>Photography</h1>
    <p class="lede">An eye behind the numbers — a gallery of what I see outside spreadsheets and dashboards.</p>
  </section>

  <section class="section gallery reveal" style="--d: 0.15s">
    <div class="gallery-frame">
      <div class="frame-content">
        <h2>View the collection</h2>
        <p>My latest work lives on VSCO — films, frames, and street moments.</p>
        <a href="https://vsco.co/nasiya-pervez/gallery" target="_blank" rel="noopener" class="btn btn-primary">
          Open VSCO gallery
        </a>
      </div>
    </div>
  </section>

  <style>
    .page-head {
      padding: 24px 0 8px;
    }

    .lede {
      max-width: 560px;
      font-size: 1.05rem;
      margin-top: 10px;
    }

    .gallery {
      margin-top: 8px;
    }

    .gallery-frame {
      background: linear-gradient(135deg, rgba(16, 185, 129, 0.14), rgba(59, 130, 246, 0.14));
      border: 1px solid var(--border);
      border-radius: 22px;
      padding: 8px;
    }

    .frame-content {
      border: 1px dashed var(--border);
      border-radius: 16px;
      padding: 72px 32px;
      text-align: center;
    }

    .frame-content h2 {
      margin-bottom: 8px;
    }

    .frame-content p {
      max-width: 420px;
      margin: 0 auto 26px;
    }

    .frame-content .btn-group {
      justify-content: center;
    }
  </style>
</Base>